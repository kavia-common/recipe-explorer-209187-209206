---
export interface Recipe {
  id: string;
  title: string;
  image?: string;
  duration: number;
  servings: number;
  tags?: string[];
}
export interface Props { recipe: Recipe }
const { recipe } = Astro.props as Props;
---

<a class="card" href={`/recipes/${recipe.id}`}>
  <div class="thumb-wrap">
    <img class="thumb" src={recipe.image ?? 'https://images.unsplash.com/photo-1504674900247-0877df9cc836?q=80&w=1200&auto=format&fit=crop'} alt={recipe.title} loading="lazy" />
  </div>
  <div class="content">
    <h3 class="title">{recipe.title}</h3>
    <div class="meta">
      <span class="chip">{recipe.duration} min</span>
      <span class="chip">{recipe.servings} servings</span>
    </div>
  </div>
</a>

<style>
  .card {
    display: grid;
    grid-template-rows: 160px auto;
    text-decoration: none;
    color: inherit;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    box-shadow: 0 10px 24px var(--shadow-color);
    overflow: hidden;
    transition: transform .16s ease, box-shadow .2s ease, border-color .2s ease;
  }
  .card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--primary), var(--border-color) 70%);
    box-shadow: 0 14px 28px var(--shadow-hover-color);
  }
  .thumb-wrap { overflow: hidden; background: #e5eefc; }
  .thumb { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .25s ease; }
  .card:hover .thumb { transform: scale(1.04); }

  .content { padding: 12px; display: grid; gap: 8px; }
  .title { margin: 0; font-size: 1rem; line-height: 1.35; }
  .meta { display: flex; gap: 8px; flex-wrap: wrap; }
  .chip {
    background: color-mix(in oklab, var(--secondary), transparent 86%);
    border: 1px solid var(--border-color);
    border-radius: 999px;
    padding: 4px 8px; font-size: .8rem;
    color: var(--text-color);
  }
</style>
