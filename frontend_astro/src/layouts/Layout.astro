---
import ThemeToggle from '../components/ThemeToggle.astro';
const APP_NAME = 'Recipe Explorer';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{APP_NAME}</title>
    <meta name="description" content="Browse, search, and view delicious recipes." />
  </head>
  <body>
    <div class="bg-gradient"></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="navbar" role="banner">
      <div class="nav-container">
        <a href="/" class="brand" aria-label="Home">
          <span class="brand-dot" aria-hidden="true"></span>
          <span class="brand-title">{APP_NAME}</span>
        </a>
        <nav aria-label="Primary navigation">
          <ul class="nav-list">
            <li><a href="/" class="nav-link active">Home</a></li>
            <li><a href="#" class="nav-link" aria-disabled="true">Collections</a></li>
            <li><a href="#" class="nav-link" aria-disabled="true">About</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="page-container">
      <slot />
    </main>

    <footer class="footer" role="contentinfo">
      <div class="footer-inner">
        <p>© {new Date().getFullYear()} {APP_NAME}. All rights reserved.</p>
        <ul class="footer-links">
          <li><a href="#" aria-disabled="true">Privacy</a></li>
          <li><a href="#" aria-disabled="true">Terms</a></li>
          <li><a href="#" aria-disabled="true">Contact</a></li>
        </ul>
      </div>
    </footer>

    <ThemeToggle />
  </body>
</html>

<style>
  :root {
    /* Ocean Professional theme */
    --primary: #2563EB;
    --secondary: #F59E0B;
    --success: #F59E0B;
    --error: #EF4444;
    --background: #f9fafb;
    --surface: #ffffff;
    --text: #111827;

    --bg-color: var(--background);
    --text-color: var(--text);
    --text-secondary: #4b5563;
    --border-color: rgba(0, 0, 0, 0.08);
    --card-bg: var(--surface);
    --card-hover-bg: #f5f7fb;
    --shadow-color: rgba(2, 6, 23, 0.08);
    --shadow-hover-color: rgba(2, 6, 23, 0.14);

    --radius: 14px;
    --radius-sm: 10px;
    --radius-lg: 18px;
    --focus: 0 0 0 3px rgba(37, 99, 235, 0.35);
  }

  body.dark-theme {
    --bg-color: #0b1220;
    --text-color: #f9fafb;
    --text-secondary: #d1d5db;
    --border-color: rgba(255, 255, 255, 0.15);
    --card-bg: rgba(17, 24, 39, 0.8);
    --card-hover-bg: rgba(31, 41, 55, 0.9);
    --shadow-color: rgba(2, 6, 23, 0.4);
    --shadow-hover-color: rgba(2, 6, 23, 0.5);
  }

  html, body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    background: var(--bg-color);
    color: var(--text-color);
    font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Inter, Helvetica, Arial, "Apple Color Emoji", "Segoe UI Emoji";
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .bg-gradient {
    position: fixed;
    inset: 0;
    background: radial-gradient(800px 400px at 10% -10%, rgba(37,99,235,.12), transparent 60%),
                radial-gradient(800px 400px at 110% 10%, rgba(245,158,11,.12), transparent 60%),
                linear-gradient(to bottom right, rgba(59,130,246,0.06), rgba(249,250,251,1));
    pointer-events: none;
    z-index: -1;
  }
  body.dark-theme .bg-gradient {
    background: radial-gradient(800px 400px at 10% -10%, rgba(37,99,235,.18), transparent 60%),
                radial-gradient(800px 400px at 110% 10%, rgba(245,158,11,.18), transparent 60%),
                linear-gradient(to bottom right, rgba(2,6,23,1), rgba(15,23,42,1));
  }

  .skip-link {
    position: absolute;
    left: -10000px;
    top: auto;
    width: 1px; height: 1px;
    overflow: hidden;
  }
  .skip-link:focus {
    position: fixed;
    left: 16px; top: 16px;
    width: auto; height: auto;
    background: var(--surface);
    color: var(--text-color);
    border-radius: var(--radius-sm);
    padding: 8px 12px;
    box-shadow: var(--focus);
    z-index: 1000;
  }

  .navbar {
    position: sticky;
    top: 0;
    backdrop-filter: blur(10px);
    background: color-mix(in oklab, var(--bg-color) 85%, transparent);
    border-bottom: 1px solid var(--border-color);
    z-index: 20;
  }
  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text-color);
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.2px;
  }
  .brand-dot {
    width: 12px; height: 12px;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--primary), color-mix(in oklab, var(--primary), white 20%));
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--primary), transparent 80%),
                0 6px 16px rgba(37, 99, 235, 0.3);
  }
  .brand-title { font-size: 1.05rem; }

  .nav-list {
    display: flex; gap: 16px; list-style: none; margin: 0; padding: 0;
  }
  .nav-link {
    text-decoration: none;
    color: var(--text-secondary);
    font-weight: 500;
    padding: 8px 10px;
    border-radius: 10px;
    transition: color .2s ease, background-color .2s ease;
  }
  .nav-link:hover { color: var(--text-color); background: color-mix(in oklab, var(--primary), transparent 92%); }
  .nav-link.active { color: var(--text-color); }

  .page-container {
    max-width: 1200px;
    padding: 28px 20px 56px;
    margin: 0 auto;
  }

  .footer {
    border-top: 1px solid var(--border-color);
    background: color-mix(in oklab, var(--bg-color) 90%, transparent);
  }
  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
    display: flex; gap: 12px;
    align-items: center; justify-content: space-between;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }
  .footer-links { display:flex; gap:12px; list-style:none; margin:0; padding:0; }
  .footer a { color: inherit; text-decoration: none; }
  .footer a:hover { color: var(--text-color); }
</style>
